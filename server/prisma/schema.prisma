// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  uid       String    @id
  name      String
  email     String    @unique
  roles     Json      // Array of roles (e.g., ["author"], ["admin"])
  bio       String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  papers           Paper[]
  reviews          Review[]
  reviewerProfile  ReviewerProfile?
  assignments      ReviewAssignment[]
}

model Paper {
  id             String    @id @default(uuid())
  title          String
  abstract       String
  keywords       Json
  domain         String?
  
  authorId       String
  author         User      @relation(fields: [authorId], references: [uid])
  
  authorName     String
  authorEmail    String
  institution    String?
  coAuthors      Json?     // Stored as JSON array
  
  fileUrl        String?
  fileName       String?
  originalFileUrl  String?   // Preserved clean copy for re-formatting
  originalFileName String?
  
  status         String    @default("submitted") 
  // Statuses: submitted, under_review, revision_required, accepted, rejected, published
  
  submittedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  reviewers      Json      // Array of reviewer User `uid`s
  
  volume         Int?
  issue          Int?
  doi            String?
  year           Int?
  editorComments String?
  
  reviews        Review[]
  payments       Payment[]
  assignments    ReviewAssignment[]
}

model Review {
  id              String   @id @default(uuid())
  paperId         String
  paper           Paper    @relation(fields: [paperId], references: [id])
  
  reviewerId      String
  reviewer        User     @relation(fields: [reviewerId], references: [uid])
  
  // Structured review fields
  positives       String?   // What's good about the paper
  negatives       String?   // What needs improvement
  corrections     String?   // Specific things author must fix before publishing
  suggestions     String?   // General suggestions for improvement
  decision        String    // accept | reject | minor_revision | major_revision
  confidenceLevel String?   // high | medium | low
  overallComments String?   // Any additional remarks
  
  // Legacy field kept for backward compatibility
  comments        String?
  
  createdAt       DateTime @default(now())
}

model ReviewerProfile {
  uid               String   @id  // Same as User.uid
  user              User     @relation(fields: [uid], references: [uid])
  phone             String?
  university        String?
  specialization    String?
  hasExperience     Boolean  @default(false)
  experienceDetails String?  // Journal names, years of experience, etc.
  completedAt       DateTime @default(now())
}

model ReviewAssignment {
  id          String    @id @default(uuid())
  paperId     String
  paper       Paper     @relation(fields: [paperId], references: [id])
  reviewerId  String
  reviewer    User      @relation(fields: [reviewerId], references: [uid])
  status      String    @default("pending")  // pending | accepted | declined
  assignedAt  DateTime  @default(now())
  respondedAt DateTime?

  @@unique([paperId, reviewerId])
}

model Payment {
  id                String   @id @default(uuid())
  paperId           String
  paper             Paper    @relation(fields: [paperId], references: [id])
  
  amount            Float
  status            String
  razorpayOrderId   String?
  razorpayPaymentId String?
  
  createdAt         DateTime @default(now())
}

model SiteContent {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
model HeaderLayout {
  id          Int      @id @default(autoincrement())
  journalName String   @unique
  layout      Json     // [{type:'logo'|'text', x:number, y:number, fontSize?:number, scale?:number}]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

